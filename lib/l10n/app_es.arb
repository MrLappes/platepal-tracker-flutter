  "screensPrivacyTitle": "Política de privacidad",
  "@screensPrivacyTitle": {
    "description": "Título de la política de privacidad en la aplicación"
  },
  "screensPrivacyEffectiveDate": "Fecha de entrada en vigor: 2026-09-30",
  "@screensPrivacyEffectiveDate": {
